rm -f out2d.* to.* from.*
./main2d.gnu.DEBUG.TPROF.MPI.ex inputs grid_type=regular vel_type=nd  prob_type=unstretched | tee out2d.reg.unstretched.nd
./main2d.gnu.DEBUG.TPROF.MPI.ex inputs grid_type=regular vel_type=cc  prob_type=unstretched | tee out2d.reg.unstretched.cc
./main2d.gnu.DEBUG.TPROF.MPI.ex inputs grid_type=regular vel_type=mac prob_type=unstretched | tee out2d.reg.unstretched.mac
./main2d.gnu.DEBUG.TPROF.MPI.ex inputs grid_type=terrain vel_type=nd  prob_type=unstretched | tee out2d.ter.unstretched.nd
./main2d.gnu.DEBUG.TPROF.MPI.ex inputs grid_type=terrain vel_type=cc  prob_type=unstretched | tee out2d.ter.unstretched.cc
./main2d.gnu.DEBUG.TPROF.MPI.ex inputs grid_type=terrain vel_type=mac prob_type=unstretched | tee out2d.ter.unstretched.mac
./main3d.gnu.DEBUG.TPROF.MPI.ex inputs grid_type=regular vel_type=nd  prob_type=unstretched | tee out3d.reg.unstretched.nd
./main3d.gnu.DEBUG.TPROF.MPI.ex inputs grid_type=regular vel_type=cc  prob_type=unstretched | tee out3d.reg.unstretched.cc
./main3d.gnu.DEBUG.TPROF.MPI.ex inputs grid_type=regular vel_type=mac prob_type=unstretched | tee out3d.reg.unstretched.mac
./main3d.gnu.DEBUG.TPROF.MPI.ex inputs grid_type=terrain vel_type=nd  prob_type=unstretched | tee out3d.ter.unstretched.nd
./main3d.gnu.DEBUG.TPROF.MPI.ex inputs grid_type=terrain vel_type=cc  prob_type=unstretched | tee out3d.ter.unstretched.cc
./main3d.gnu.DEBUG.TPROF.MPI.ex inputs grid_type=terrain vel_type=mac prob_type=unstretched | tee out3d.ter.unstretched.mac
grep FROM out2d.reg.unstretched.nd  | head -16 > from2d.un.reg.nd
grep TO   out2d.reg.unstretched.nd   | tail -16 > to2d.un.reg.nd
grep TO   out2d.reg.unstretched.cc   | tail -16 > to2d.un.reg.cc
grep TO   out2d.reg.unstretched.mac  | tail -16 > to2d.un.reg.mac
grep TO   out2d.ter.unstretched.nd   | tail -16 > to2d.un.ter.nd
grep TO   out2d.ter.unstretched.cc   | tail -16 > to2d.un.ter.cc
grep TO   out2d.ter.unstretched.mac  | tail -16 > to2d.un.ter.mac
grep TO   out3d.reg.unstretched.nd   | tail -16 > to3d.un.reg.nd
grep TO   out3d.reg.unstretched.cc   | tail -16 > to3d.un.reg.cc
grep TO   out3d.reg.unstretched.mac  | tail -16 > to3d.un.reg.mac
grep TO   out3d.ter.unstretched.nd   | tail -16 > to3d.un.ter.nd
grep TO   out3d.ter.unstretched.cc   | tail -16 > to3d.un.ter.cc
grep TO   out3d.ter.unstretched.mac  | tail -16 > to3d.un.ter.mac
ls from2d.* | xargs sed -i -e 's/FROM//g'
ls to2d.*   | xargs sed -i -e 's/TO//g'
ls from3d.* | xargs sed -i -e 's/FROM//g'
ls to3d.*   | xargs sed -i -e 's/TO//g'
