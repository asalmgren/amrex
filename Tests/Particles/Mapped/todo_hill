rm -f out2d.* to.* from.*
./main2d.gnu.DEBUG.TPROF.MPI.ex inputs grid_type=terrain vel_type=nd  prob_type=hill | tee out2d.ter.hill.nd
./main2d.gnu.DEBUG.TPROF.MPI.ex inputs grid_type=terrain vel_type=cc  prob_type=hill | tee out2d.ter.hill.cc
./main2d.gnu.DEBUG.TPROF.MPI.ex inputs grid_type=terrain vel_type=mac prob_type=hill | tee out2d.ter.hill.mac
./main3d.gnu.DEBUG.TPROF.MPI.ex inputs grid_type=terrain vel_type=nd  prob_type=hill | tee out3d.ter.hill.nd
./main3d.gnu.DEBUG.TPROF.MPI.ex inputs grid_type=terrain vel_type=cc  prob_type=hill | tee out3d.ter.hill.cc
./main3d.gnu.DEBUG.TPROF.MPI.ex inputs grid_type=terrain vel_type=mac prob_type=hill | tee out3d.ter.hill.mac
grep FROM out2d.ter.hill.nd  | head -16 > from2d.hill.ter.nd
grep TO   out2d.ter.hill.nd   | tail -16 > to2d.hill.ter.nd
grep TO   out2d.ter.hill.cc   | tail -16 > to2d.hill.ter.cc
grep TO   out2d.ter.hill.mac  | tail -16 > to2d.hill.ter.mac
grep TO   out3d.ter.hill.nd   | tail -16 > to3d.hill.ter.nd
grep TO   out3d.ter.hill.cc   | tail -16 > to3d.hill.ter.cc
grep TO   out3d.ter.hill.mac  | tail -16 > to3d.hill.ter.mac
ls from2d.* | xargs sed -i -e 's/FROM//g'
ls to2d.*   | xargs sed -i -e 's/TO//g'
ls from3d.* | xargs sed -i -e 's/FROM//g'
ls to3d.*   | xargs sed -i -e 's/TO//g'
