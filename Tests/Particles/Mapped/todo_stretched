rm -f out2d.* to.* from.*
./main2d.gnu.DEBUG.TPROF.MPI.ex inputs grid_type=terrain vel_type=nd  prob_type=stretched | tee out2d.ter.stretched.nd
./main2d.gnu.DEBUG.TPROF.MPI.ex inputs grid_type=terrain vel_type=cc  prob_type=stretched | tee out2d.ter.stretched.cc
./main2d.gnu.DEBUG.TPROF.MPI.ex inputs grid_type=terrain vel_type=mac prob_type=stretched | tee out2d.ter.stretched.mac
./main3d.gnu.DEBUG.TPROF.MPI.ex inputs grid_type=terrain vel_type=nd  prob_type=stretched | tee out3d.ter.stretched.nd
./main3d.gnu.DEBUG.TPROF.MPI.ex inputs grid_type=terrain vel_type=cc  prob_type=stretched | tee out3d.ter.stretched.cc
./main3d.gnu.DEBUG.TPROF.MPI.ex inputs grid_type=terrain vel_type=mac prob_type=stretched | tee out3d.ter.stretched.mac
grep FROM out2d.ter.stretched.nd  | head -16 > from2d.st.reg.nd
grep TO   out2d.ter.stretched.nd   | tail -16 > to2d.st.ter.nd
grep TO   out2d.ter.stretched.cc   | tail -16 > to2d.st.ter.cc
grep TO   out2d.ter.stretched.mac  | tail -16 > to2d.st.ter.mac
grep TO   out3d.ter.stretched.nd   | tail -16 > to3d.st.ter.nd
grep TO   out3d.ter.stretched.cc   | tail -16 > to3d.st.ter.cc
grep TO   out3d.ter.stretched.mac  | tail -16 > to3d.st.ter.mac
ls from2d.* | xargs sed -i -e 's/FROM//g'
ls to2d.*   | xargs sed -i -e 's/TO//g'
ls from3d.* | xargs sed -i -e 's/FROM//g'
ls to3d.*   | xargs sed -i -e 's/TO//g'
